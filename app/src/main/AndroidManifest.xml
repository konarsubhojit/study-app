<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to the StudyFlow backend over HTTPS (issue #63). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The material upload worker runs as a foreground service while a transfer is in progress,
         so a multi-hundred-megabyte lecture recording is not killed as soon as the app is
         backgrounded (issue #38). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".StudyFlowApplication"
        android:label="StudyFlow">
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            tools:targetApi="tiramisu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="studyflow" />
                <data android:host="home" />
                <data android:host="timer" />
                <data android:host="materials" />
                <data android:host="tasks" />
                <data android:host="history" />
                <data android:host="settings" />
                <data android:host="widget" />
            </intent-filter>

            <!-- Share target for materials import (issue #37): a document picked in Drive, an
                 attachment opened in Gmail, an image from a browser, or a file from a classmate's
                 chat can all be sent to StudyFlow from the system share sheet. No storage
                 permission is declared or required — the sender's URI is read directly. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".injection.StudyFlowInjectionService"
            android:exported="false" />

        <service
            android:name=".timer.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <!-- Keeps the user-started study timer visible and controllable (pause, resume, stop,
                 open) after leaving the app without app-driven ticking or wake locks. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Ongoing study-session timer notification controls" />
        </service>

        <receiver
            android:name=".injection.StudyFlowInjectionReceiver"
            android:exported="false" />

        <receiver
            android:name=".timer.TimerRecoveryReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".timer.TimerIntervalReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
            <meta-data
                android:name="dev.studyflow.app.startup.AppStartupInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
