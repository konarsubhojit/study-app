<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors android:allowBackup="false": no app data leaves the device via cloud backup or
     device-to-device transfer on Android 12 and higher. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
