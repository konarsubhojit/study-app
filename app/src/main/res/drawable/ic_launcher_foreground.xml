<!--
    StudyFlow launcher mark (issue #169): a bookmark ribbon — saved study materials — with a
    clock face cut into it to stand for the study timer. The ribbon and hands are drawn in white
    so they read against the indigo `ic_launcher_background`; the circular clock face is cut out
    of the ribbon with an even-odd fill so the background shows through as the clock dial.

    All artwork sits within x:[36,72] / y:[23,80] on the 108x108 canvas, comfortably inside the
    adaptive-icon safe zone (the inner 66dp square, x/y:[21,87]), so it survives circle, squircle
    and rounded-square masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bookmark ribbon with a circular clock-face hole cut out of it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M36,23L72,23L72,80L54,66L36,80Z M61,40A7,7 0 1,0 47,40A7,7 0 1,0 61,40Z" />
    <!-- Clock hands, drawn over the cut-out so they show white against the indigo dial. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M53.2,40L53.2,32L54.8,32L54.8,40Z M54,39.2L60,39.2L60,40.8L54,40.8Z" />
</vector>
