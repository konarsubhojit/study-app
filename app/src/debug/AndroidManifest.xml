<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Debug builds may talk to a mock backend on the developer's machine over plain HTTP, which
        release builds must never do. Keeping the exception in the debug source set means running
        against a local backend needs no code change and cannot ship (issue #63).
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
