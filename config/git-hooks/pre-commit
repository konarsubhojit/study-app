#!/bin/sh
# Opt-in formatting hint (issue #13).
#
# Enable with:
#   git config core.hooksPath config/git-hooks
# Disable with:
#   git config --unset core.hooksPath
#
# This is a hint, not a gate: it only reports formatting, never rewrites a staged file, and CI
# remains the authority. Skip it for a single commit with `git commit --no-verify`.

set -e

staged_kotlin=$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts')
if [ -z "$staged_kotlin" ]; then
    exit 0
fi

if ! ./gradlew --quiet spotlessCheck; then
    echo
    echo "Formatting check failed. Run './gradlew spotlessApply', restage, and commit again."
    echo "Commit anyway with 'git commit --no-verify'; CI still runs './gradlew check'."
    exit 1
fi
